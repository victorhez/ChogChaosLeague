# Everything is optional. The app runs with the defaults below.
# Chog Genesis (ERC-721 on Monad). Default is already 0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763.
NEXT_PUBLIC_CHOG_CONTRACT=
# Deployed ChaosLedger address. When set, the Verified badge compares proofs with the on-chain season root.
NEXT_PUBLIC_LEDGER_ADDRESS=
NEXT_PUBLIC_MONAD_RPC=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_BACKUP=
# Durable nudge store (Upstash Redis REST, or the Vercel KV variables KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
